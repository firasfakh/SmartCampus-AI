# ============================================
# SmartCampus AI — Variables d'environnement
# ============================================
# Copier ce fichier en .env et remplir les valeurs.
# Ne jamais committer le fichier .env dans le repository.

# --- Informations du projet ---
PROJECT_NAME=SmartCampus AI API
VERSION=0.1.0

# --- Base de données PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=smartcampus
POSTGRES_PASSWORD=votre_mot_de_passe_ici
POSTGRES_DB=smartcampus_db

# --- Sécurité ---
# Générer une clé secrète forte : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=changez-moi-en-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS ---
# Origines autorisées pour le frontend (séparées par des virgules dans le code)
# Configurées par défaut pour le développement local

# --- Stockage des documents ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
