# ============================================
# SmartCampus AI — Variables d'environnement du backend
# ============================================
# 1. Copier ce fichier :  copy .env.example .env   (Windows)  /  cp .env.example .env
# 2. Générer une clé secrète :
#    python -c "import secrets; print(secrets.token_urlsafe(64))"
# Ne jamais committer le fichier .env.

ENVIRONMENT=development

# --- PostgreSQL ---
# Avec Docker (docker compose up -d db) : hôte 127.0.0.1, port 5433.
# Avec un PostgreSQL installé sur Windows : port 5432 en général.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=smartcampus
POSTGRES_PASSWORD=smartcampus_dev_only
POSTGRES_DB=smartcampus_db

# --- Sécurité (SA-28) ---
SECRET_KEY=remplacer-par-une-cle-generee-de-64-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Sessions visiteurs et mémoire (SA-25 / SA-26) ---
VISITOR_SESSION_TTL_HOURS=24
VISITOR_MAX_CONVERSATIONS=5
VISITOR_MAX_MESSAGES=60
MEMORY_WINDOW_MESSAGES=20
VISITOR_CLEANUP_INTERVAL_MINUTES=60

# --- CORS (origines du frontend, séparées par des virgules) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Stockage des documents ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
